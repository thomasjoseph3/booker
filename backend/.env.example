PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/hotel_agent
JWT_SECRET=change-me-to-a-long-random-string
# Base URL that guests' payment links / callbacks resolve to (use an https tunnel like ngrok for real gateways)
PUBLIC_BASE_URL=http://localhost:4000
# Next.js admin dashboard (../admin)
ADMIN_URL=http://localhost:3000

# Platform key for a single agent deployment that serves many hotels (send x-api-key + x-hotel-id).
# Each hotel also gets its own key (see seed output / admin "rotate agent key").
AGENT_MASTER_KEY=change-me-master-agent-key

# Payment provider: mock | razorpay | stripe
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# How often (seconds) to expire unpaid booking holds
HOLD_SWEEP_SECONDS=60

# Default country code for guest numbers given without "+"
DEFAULT_COUNTRY_CODE=91

# Guest messages (payment link, confirmation + check-in details, cancellations) go out on WhatsApp.
# log = store/print only (dev) | meta = WhatsApp Cloud API | twilio = Twilio WhatsApp
WHATSAPP_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved template names (required for business-initiated messages in production)
WHATSAPP_TEMPLATE_PAYMENT_LINK=
WHATSAPP_TEMPLATE_CONFIRMED=
WHATSAPP_TEMPLATE_MODIFIED=
WHATSAPP_TEMPLATE_CANCELLED=
WHATSAPP_TEMPLATE_EXPIRED=
WHATSAPP_TEMPLATE_PAYMENT_ISSUE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Channels guest messages go out on: whatsapp, email, or both (comma separated)
GUEST_CHANNELS=whatsapp
# Email via SMTP (Gmail: smtp.gmail.com / 587 / your address / an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Hotel Bookings <you@example.com>"
# Dev/demo: deliver every guest email to this address instead of the guest's own
EMAIL_OVERRIDE_TO=

# AI agents (Google AI Studio key). Free keys have small per-minute AND per-day quotas per model; when the
# primary model is out of quota the fallbacks are tried in order. Put a model with quota left first, or enable billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Live (real-time audio) agent used by the public website's call button
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede
MAX_LIVE_CALLS=5
MAX_LIVE_MINUTES=10
