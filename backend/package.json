{
  "name": "hotel-agent-backend",
  "version": "1.0.0",
  "description": "Multi-property hotel booking backend for an AI tele-caller agent",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smoke.js",
    "demo:call": "node scripts/demo-call.js",
    "mcp": "node src/mcp/main.js",
    "mcp:dev": "node --watch src/mcp/main.js",
    "mcp:token": "node scripts/mcp-token.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\"",
    "test": "npm run test:unit && npm run smoke",
    "test:unit": "node --test --import ./test/setup.js test/unit",
    "test:coverage": "node --test --experimental-test-coverage --import ./test/setup.js test/unit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.16",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "nodemailer": "^10.1.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.10"
  }
}
